generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MenuItem {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  precio      Decimal  @db.Decimal(10, 2)
  categoria   String
  disponible  Boolean  @default(true)
  foto_url      String?
  calorias      Int?
  proteinas     Float?
  carbohidratos Float?
  grasas        Float?
  ingredientes  String?
  tagline       String?
  tags          String[] @default([])
  menu_del_dia  Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  pedido_items PedidoItem[]
  components   MenuItemComponent[]
  
  receta_id    String?
  receta       Receta?  @relation(fields: [receta_id], references: [id], onDelete: SetNull)

  @@map("menu_items")
}

model MenuItemComponent {
  id            String   @id @default(cuid())
  menu_item_id  String
  nombre        String
  cantidad_label String
  foto_url      String?
  orden         Int      @default(0)
  created_at    DateTime @default(now())

  menu_item     MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)

  @@map("menu_item_components")
}

model Pedido {
  id               String   @id @default(cuid())
  numero_pedido    Int      @default(autoincrement())
  cliente_nombre   String
  cliente_telefono String
  modalidad        Modalidad
  direccion_entrega String?
  fecha_entrega    DateTime
  hora_entrega     String
  comentarios      String?
  estado           EstadoPedido @default(PENDIENTE)
  total            Decimal  @db.Decimal(10, 2)
  visto            Boolean  @default(false)
  descuento_vouchers Decimal @default(0) @db.Decimal(10, 2)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  items    PedidoItem[]
  vouchers Voucher[]

  @@map("pedidos")
}

model PedidoItem {
  id             String  @id @default(cuid())
  pedido_id      String
  menu_item_id   String
  cantidad       Int
  precio_unitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  pedido    Pedido    @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  menu_item MenuItem  @relation(fields: [menu_item_id], references: [id])

  @@map("pedido_items")
}

model Configuracion {
  id    String @id @default(cuid())
  clave String @unique
  valor String

  @@map("configuracion")
}

model WhatsappTemplate {
  id         Int      @id @default(autoincrement())
  estado     String   @unique
  habilitado Boolean  @default(true)
  plantilla  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("whatsapp_templates")
}

enum Modalidad {
  RETIRO
  DELIVERY
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  ENTREGADO
  CANCELADO
}

model Insumo {
  id              String   @id @default(cuid())
  nombre          String
  unidad_medida   String
  costo_unitario  Decimal  @db.Decimal(10, 2)
  stock_actual    Float    @default(0)
  stock_minimo    Float    @default(0)
  proveedor       String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  ingredientes_receta IngredienteReceta[]
  movimientos         MovimientoStock[]

  @@map("insumos")
}

model MovimientoStock {
  id              String   @id @default(cuid())
  insumo_id       String
  tipo            TipoMovimiento
  cantidad        Float
  motivo          String?
  pedido_id       String?
  created_at      DateTime @default(now())

  insumo          Insumo   @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  @@map("movimientos_stock")
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

model Receta {
  id              String   @id @default(cuid())
  nombre          String
  descripcion     String?
  rendimiento     Float    @default(1)
  costo_total     Decimal  @default(0) @db.Decimal(10, 2)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  ingredientes    IngredienteReceta[]
  menu_items      MenuItem[]

  @@map("recetas")
}

model IngredienteReceta {
  id              String   @id @default(cuid())
  receta_id       String
  insumo_id       String
  cantidad        Float
  merma           Float    @default(0)
  created_at      DateTime @default(now())
  
  receta          Receta   @relation(fields: [receta_id], references: [id], onDelete: Cascade)
  insumo          Insumo   @relation(fields: [insumo_id], references: [id], onDelete: Restrict)

  @@map("ingredientes_receta")
}

// ── Convenios corporativos ──────────────────────────────────────────────

model LeadEmpresa {
  id                 String         @id @default(cuid())
  empresa            String
  contacto_nombre    String
  cargo              String?
  email              String
  telefono           String
  cantidad_empleados Int?
  paquete_interes    PaqueteInteres
  zona               String
  comentarios        String?
  estado             EstadoLead     @default(NUEVO)
  notas_internas     String?
  visto              Boolean        @default(false)
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  convenio Convenio?

  @@map("leads_empresas")
}

model Convenio {
  id                String   @id @default(cuid())
  empresa           String
  cuit              String?
  contacto_nombre   String
  email             String
  telefono          String
  vouchers_por_mes  Int
  precio_por_vianda Decimal? @db.Decimal(10, 2)
  activo            Boolean  @default(true)
  lead_id           String?  @unique
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  lead  LeadEmpresa?  @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  lotes VoucherLote[]

  @@map("convenios")
}

model VoucherLote {
  id          String   @id @default(cuid())
  convenio_id String
  periodo     String   // "YYYY-MM"
  cantidad    Int
  vence_at    DateTime
  created_at  DateTime @default(now())

  convenio Convenio  @relation(fields: [convenio_id], references: [id], onDelete: Cascade)
  vouchers Voucher[]

  @@unique([convenio_id, periodo])
  @@map("voucher_lotes")
}

model Voucher {
  id          String        @id @default(cuid())
  codigo      String        @unique
  lote_id     String
  estado      EstadoVoucher @default(DISPONIBLE)
  pedido_id   String?
  canjeado_at DateTime?
  created_at  DateTime      @default(now())

  lote   VoucherLote @relation(fields: [lote_id], references: [id], onDelete: Cascade)
  pedido Pedido?     @relation(fields: [pedido_id], references: [id], onDelete: SetNull)

  @@index([lote_id, estado])
  @@map("vouchers")
}

enum PaqueteInteres {
  P50
  P75
  P100
  A_MEDIDA
}

enum EstadoLead {
  NUEVO
  CONTACTADO
  PROPUESTA
  GANADO
  PERDIDO
}

enum EstadoVoucher {
  DISPONIBLE
  CANJEADO
  ANULADO
}
