generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MenuItem {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  precio      Decimal  @db.Decimal(10, 2)
  categoria   String
  disponible  Boolean  @default(true)
  foto_url      String?
  calorias      Int?
  proteinas     Float?
  carbohidratos Float?
  grasas        Float?
  ingredientes  String?
  tagline       String?
  tags          String[] @default([])
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  pedido_items PedidoItem[]
  components   MenuItemComponent[]

  @@map("menu_items")
}

model MenuItemComponent {
  id            String   @id @default(cuid())
  menu_item_id  String
  nombre        String
  cantidad_label String
  foto_url      String?
  orden         Int      @default(0)
  created_at    DateTime @default(now())

  menu_item     MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)

  @@map("menu_item_components")
}

model Pedido {
  id               String   @id @default(cuid())
  numero_pedido    Int      @default(autoincrement())
  cliente_nombre   String
  cliente_telefono String
  modalidad        Modalidad
  direccion_entrega String?
  fecha_entrega    DateTime
  hora_entrega     String
  comentarios      String?
  estado           EstadoPedido @default(PENDIENTE)
  total            Decimal  @db.Decimal(10, 2)
  visto            Boolean  @default(false)
  created_at       DateTime @default(now())

  items PedidoItem[]

  @@map("pedidos")
}

model PedidoItem {
  id             String  @id @default(cuid())
  pedido_id      String
  menu_item_id   String
  cantidad       Int
  precio_unitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  pedido    Pedido    @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  menu_item MenuItem  @relation(fields: [menu_item_id], references: [id])

  @@map("pedido_items")
}

model Configuracion {
  id    String @id @default(cuid())
  clave String @unique
  valor String

  @@map("configuracion")
}

enum Modalidad {
  RETIRO
  DELIVERY
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  ENTREGADO
  CANCELADO
}
